# Copy to .env next to docker-compose.yml, then run:
# docker compose -f docker-compose.yml -f docker-compose.tunnel.yml up -d --build

CAP_URL=https://oiaai.clubemkt.digital

# Cloudflare Zero Trust > Tunnels > your tunnel > token.
CLOUDFLARE_TUNNEL_TOKEN=

# Public hostname routed to http://minio:9000, used for video playback.
S3_PUBLIC_URL=https://oiaai-s3.clubemkt.digital

# Generate with: openssl rand -hex 32
DATABASE_ENCRYPTION_KEY=
NEXTAUTH_SECRET=
MEDIA_SERVER_WEBHOOK_SECRET=

MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Optional
RESEND_API_KEY=
RESEND_FROM_DOMAIN=
